# Django Settings
SECRET_KEY=
ALLOWED_HOSTS=
STATIC_URL=/static/
MEDIA_URL=/media/

# Database Configuration
DB_NAME=databus
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=database
DB_PORT=5432

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=message-broker
RABBITMQ_PORT=5672

# Redis Configuration
REDIS_HOST=state
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# Google Maps API Key
API_TOKEN=

# HiveMQ Configuration
HIVEMQ_LOG_LEVEL=INFO

# Prefect Configuration
PREFECT_SERVER_API_HOST=0.0.0.0
PREFECT_API_URL=http://localhost:4200/api

# Host Machine Port Configuration
BACKEND_PORT=8000
DATABASE_PORT=5432
STATE_PORT=6379
MQTT_BROKER_PORT=1883
MESSAGE_BROKER_AMQP_PORT=5672
MESSAGE_BROKER_MANAGEMENT_PORT=15672
MESSAGE_BROKER_PROMETHEUS_PORT=15692
ANALYTICS_PORT=4200
TASK_MONITORING_PORT=5555
USER_INTERFACE_PORT=13000

# Domains in production
ORCHESTRATOR_DOMAIN=api.databus.simovilab.com
UI_DOMAIN=databus.simovilab.com
MQTT_DOMAIN=mqtt.databus.simovilab.com
RABBITMQ_DOMAIN=rabbitmq.databus.simovilab.com
ANALYTICS_DOMAIN=flows.databus.simovilab.com
FLOWER_DOMAIN=tasks.databus.simovilab.com
DOCS_DOMAIN=docs.databus.simovilab.com

# Certificate in production
CERT_RESOLVER=letsencrypt

# ETA model registry (used by gtfs_eta; set to a writable directory)
# Seed the baseline model once: MODEL_REGISTRY_DIR=eta_models ./.venv/bin/python -m gtfs_eta.seed_baseline_model
MODEL_REGISTRY_DIR=eta_models
ETA_MAX_STOPS=3
ETA_DEFAULT_UNCERTAINTY_S=120